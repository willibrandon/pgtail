<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>pgtail</AssemblyName>
    <RootNamespace>Pgtail</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <PublishAot>true</PublishAot>
    <!-- The size report Dotsider checks in CI; it is written under obj and never published. -->
    <IlcGenerateMstatFile>true</IlcGenerateMstatFile>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <ToolPackageRuntimeIdentifiers>$(RuntimeIdentifiers);any</ToolPackageRuntimeIdentifiers>
    <OptimizationPreference>Speed</OptimizationPreference>
    <StripSymbols>true</StripSymbols>
    <StackTraceSupport>true</StackTraceSupport>
    <ApplicationIcon>../../art/pgtail.ico</ApplicationIcon>
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <IncludeSymbols>false</IncludeSymbols>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>pgtail</ToolCommandName>
    <PackageId>pgtail</PackageId>
    <Description>Interactive PostgreSQL log tailer with auto-detection, filtering, semantic highlighting, and a full screen tail mode.</Description>
    <PackageTags>postgresql;postgres;logs;log-viewer;tail;cli;dotnet-tool;hex1b</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hex1b" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../art/pgtail-icon.png" Pack="true" PackagePath="/icon.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Pgtail.Core/Pgtail.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pgtail.Tests" />
  </ItemGroup>

  <!--
    Hex1b ships programs for hosting a pseudo-terminal on Windows, which pgtail never starts. Package validation runs
    every program an installer puts on the machine, and these exit with an error when run on their own, so pgtail.exe
    is the only program published.
  -->
  <Target Name="RemoveUnusedWindowsProgramsFromPublish"
          AfterTargets="Publish"
          Condition="'$(RuntimeIdentifier)' == 'any' or $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-', System.StringComparison.Ordinal))">
    <ItemGroup>
      <_UnusedWindowsProgram Include="$(PublishDir)**\*.exe" Exclude="$(PublishDir)pgtail.exe" />
    </ItemGroup>
    <Delete Files="@(_UnusedWindowsProgram)" />
    <ItemGroup>
      <_LeftoverWindowsProgram Include="$(PublishDir)**\*.exe" Exclude="$(PublishDir)pgtail.exe" />
    </ItemGroup>
    <Error Condition="'@(_LeftoverWindowsProgram)' != ''"
           Text="Only pgtail.exe may be published; found @(_LeftoverWindowsProgram)." />
  </Target>

</Project>
