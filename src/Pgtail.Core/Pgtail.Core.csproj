<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Pgtail</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Scout.IO.Globbing" />
    <PackageReference Include="Scout.IO.Ignore" />
    <PackageReference Include="Scout.Text.Regex" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="pgtail" />
    <InternalsVisibleTo Include="Pgtail.Tests" />
  </ItemGroup>

</Project>
